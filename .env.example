# Run: uv run python scripts/bootstrap.py
# Bootstrap creates a unique local Owner token. Never commit .env.
STUDIO_OWNER_TOKEN=
STUDIO_NAME="AMN-AI"
STUDIO_TIMEZONE="Europe/Bucharest"
STUDIO_DATABASE_URL="sqlite:///data/studio.db"
STUDIO_HOST="127.0.0.1"
STUDIO_PORT=8000
STUDIO_ALLOWED_HOSTS='["localhost","127.0.0.1"]'
STUDIO_LOG_LEVEL="INFO"

# --- Optional integrations -------------------------------------------------------------
# Absolute path to ffmpeg. Leave empty to search PATH. Without ffmpeg the studio refuses to
# render video rather than writing a placeholder file with an .mp4 name.
STUDIO_FFMPEG_PATH=

# Official YouTube Data API v3 OAuth credentials. Without all three, publishing is disabled:
# the studio never substitutes a simulated publisher for a real one.
STUDIO_YOUTUBE_CLIENT_ID=
STUDIO_YOUTUBE_CLIENT_SECRET=
STUDIO_YOUTUBE_REFRESH_TOKEN=
# Optional: the channel these credentials publish to (informational).
STUDIO_YOUTUBE_CHANNEL_ID=

# Live weather drawn over the office scene. An Open-Meteo compatible forecast host; unset = no weather drawn.
# STUDIO_OFFICE_WEATHER_HOST=api.open-meteo.com
# STUDIO_OFFICE_LATITUDE=44.4268
# STUDIO_OFFICE_LONGITUDE=26.1025

# The headquarters rendered live in Unreal Engine (Pixel Streaming). The player port of Epic's signalling
# server (art-source/unreal/live/wilbur.config.json); unset = the page shows its own renderer.
# STUDIO_OFFICE_STREAM_SIGNALLING_URL=ws://127.0.0.1:8890
