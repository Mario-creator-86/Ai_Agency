# AMN-AI settings. Copy nothing by hand: `uv run python scripts/bootstrap.py` (or start.cmd /
# scripts/start.py) writes .env with a fresh Owner key the first time. Edit .env afterwards to
# change a value below; a commented line shows the default the studio uses when it is unset.
# Every line is read with the STUDIO_ prefix. Never commit .env and never share it.
# tests/test_env_example.py fails when a setting of backend/app/config.py is missing here.

# =============================================================================== REQUIRED ===
# The Owner key the page asks for. Written by the bootstrap; at least 32 characters.
STUDIO_OWNER_TOKEN=
# The studio's name, written into a NEW database at bootstrap (renaming later: scripts/rename_studio.py).
STUDIO_NAME="AMN-AI"
# Where the studio stands. The timezone runs the daily clock and every date the page shows; the
# coordinates light the office scene with the real sun; the city is the name under the clock;
# the holiday country (ISO 3166 alpha-2) empties the street on its public holidays (only RO's
# calendar is known; another code means ordinary days, empty means none). The defaults are the
# first studio's Bucharest: a buyer sets all five.
STUDIO_TIMEZONE="Europe/Bucharest"
# STUDIO_OFFICE_LATITUDE=44.4268
# STUDIO_OFFICE_LONGITUDE=26.1025
# STUDIO_OFFICE_CITY="București"
# STUDIO_HOLIDAY_COUNTRY="RO"
STUDIO_DATABASE_URL="sqlite:///data/studio.db"
# Local only: no TLS and no multi-user access. Do not expose the port to the Internet.
STUDIO_HOST="127.0.0.1"
STUDIO_PORT=8000
STUDIO_ALLOWED_HOSTS='["localhost","127.0.0.1"]'
# The Owner, 2026-10-08: «Te rog sa elimini pagina de logare, nu trebuie momentan». On, the page
# opened on this machine at http://127.0.0.1:<port> (or localhost / [::1]) enters without the key
# form: the studio hands it the key itself. Only to this machine: never with STUDIO_HOST beyond
# loopback, never through a proxy, never to another site's page. Every route still requires the
# key. false = the sign-in form for everyone, as before.
# STUDIO_LOCAL_AUTO_LOGIN=true

# ================================================================================= LOGGING ===
STUDIO_LOG_LEVEL="INFO"
# JSON lines in <log dir>/studio.log, rotated. Empty dir = `logs` beside the database (data/logs).
# STUDIO_LOG_TO_FILE=true
# STUDIO_LOG_DIR=
# STUDIO_LOG_FILE_MAX_BYTES=10485760
# STUDIO_LOG_FILE_BACKUPS=10
# The console's own level (the Windows service sets WARNING); empty = STUDIO_LOG_LEVEL.
# STUDIO_LOG_CONSOLE_LEVEL=WARNING

# ============================================================================= THE TOOLCHAIN ===
# FFmpeg is REQUIRED for films (libx264, aac, libass subtitles, zscale, loudnorm, xfade).
# Windows: winget install Gyan.FFmpeg · Debian/Ubuntu: sudo apt install ffmpeg · macOS: brew install ffmpeg
# Empty = search PATH. Without it the studio refuses to render rather than write a fake .mp4.
STUDIO_FFMPEG_PATH=
# Empty = PATH, then the folder ffmpeg is in. Without ffprobe quality control cannot measure a film.
STUDIO_FFPROBE_PATH=

# ======================================================================= DISK, MEDIA, BACKUPS ===
# Where films, takes and stills are written. Empty = backend/storage/media inside the studio
# folder. A film needs up to about 1.1 GB while it is made: put this on a large disk.
STUDIO_MEDIA_ROOT=
# A paid step and the daily run refuse to start with less free space than this on the media
# disk (GB). 0 turns the guard off.
STUDIO_MIN_FREE_GB=20
# The watchdog deletes the shot and card clips of renders that FAILED more than N days ago
# (never takes, stills, films or sound). Off until you turn it on.
STUDIO_SWEEP_FAILED_INTERMEDIATES=false
STUDIO_FAILED_INTERMEDIATES_DAYS=7
# Database backups: folder (empty = backups beside the database, data/backups), the daily
# hour on the studio clock, how many daily and weekly copies are kept, and the age after
# which /health/ready reports the backup as stale. scripts/backup.py makes one on demand,
# scripts/restore.py puts one back (with the studio stopped). Films are NOT in the backup.
STUDIO_BACKUP_DIR=
STUDIO_BACKUP_HOUR_LOCAL="03:30"
STUDIO_BACKUP_KEEP_DAILY=14
STUDIO_BACKUP_KEEP_WEEKLY=4
STUDIO_BACKUP_MAX_AGE_HOURS=36
# After a good backup: completed housekeeping tasks older than N days and sent outbox rows
# older than N days are deleted. Events are never deleted.
STUDIO_PRUNE_TASK_DAYS=30
STUDIO_PRUNE_OUTBOX_DAYS=7

# ================================================================= THE DAY AND THE BACKGROUND ===
# The background worker fires the scheduled jobs. The daily job is seeded DORMANT: starting it
# is the Owner's act in the page (Rularea zilnică → Pornește programarea zilnică).
# STUDIO_WORKER_ENABLED=true
# STUDIO_WORKER_INTERVAL_SECONDS=30
# When the day starts, HH:MM on the studio's clock (STUDIO_TIMEZONE).
# STUDIO_DAILY_RUN_HOUR_LOCAL="05:00"
# A day that could not run is tried again after N seconds, up to N attempts per date.
# STUDIO_DAILY_MAX_ATTEMPTS=3
# STUDIO_DAILY_RETRY_SECONDS=1800
# A stage failing on a transient fault is retried in place N times, waiting backoff*2^n s.
# STUDIO_STAGE_RETRY_ATTEMPTS=3
# STUDIO_STAGE_RETRY_BACKOFF_SECONDS=20
# A vendor's 429/5xx is asked again N times, waiting up to N seconds. A billed request that got
# no answer is never sent again.
# STUDIO_PROVIDER_RETRY_ATTEMPTS=3
# STUDIO_PROVIDER_RETRY_MAX_SECONDS=30
# The watchdog: how often it looks for stuck work, when a render counts as stuck, how often an
# uncertain publication is asked about, and when a STARTED upload is checked on YouTube.
# STUDIO_WATCHDOG_INTERVAL_SECONDS=600
# STUDIO_RENDER_STUCK_AFTER_SECONDS=10800
# STUDIO_RECONCILE_MAX_ATTEMPTS=3
# STUDIO_PUBLISH_STUCK_AFTER_SECONDS=3600
# How long a film's unspent budget hold stands before the watchdog releases it (seconds).
# STUDIO_RESERVATION_TTL_SECONDS=21600

# ===================================================================== RESEARCH AND CONTENT ===
# Hosts the research retriever may read, as bare lowercase names. Empty = only the hosts the
# Owner adds and tests in the page (Cercetare → Surse și afirmații).
STUDIO_RESEARCH_ALLOWED_HOSTS='[]'
# STUDIO_RESEARCH_CANDIDATES_PER_DAY=4
# STUDIO_RESEARCH_PAGES_PER_TOPIC=4
# Google's public "trending now" feed for this country, read once a day as a hint (never a source).
# STUDIO_TRENDS_ENABLED=true
# STUDIO_TRENDS_GEO="RO"
# The language the audience reads and hears: narration, titles, descriptions, tags.
# STUDIO_CONTENT_LANGUAGE="en"
# How long a short should be, in seconds (the writer is briefed with it).
# STUDIO_TARGET_VIDEO_SECONDS=30
# Captions burnt into the picture (false keeps only captions.srt beside the film).
# STUDIO_CAPTIONS_BURN_IN=true
# Editorial QC refuses a film when true; empty = config/factual_look.json decides (advisory).
# STUDIO_EDITORIAL_QC_BLOCKING=false
# The licensed music library (a JSON file, see config/music_library.json). Empty = that file.
# Only tracks whose licence allows commercial use are ever mixed.
# STUDIO_MUSIC_LIBRARY=

# ====================================================================== PUBLISHING (YouTube) ===
# Channels are connected in the page: Setări → Conturi și e-mail (YouTube OAuth in your own Google
# Cloud project), then bound to a channel in Distribuție → Sloturi de canal. See docs/project/YOUTUBE_CONNECTIONS.md for the consent
# screen ("In production") and the YouTube API audit a public upload needs.
# Every published description ends with the AI disclosure: the page it links to, the YouTube
# channel credited as the creator, the studio's name as the audience reads it, and your own
# sentence per content language (JSON; {studio} is replaced by the display name). Unset, the
# built-in English or Romanian sentence is used, naming no studio.
# STUDIO_AI_DISCLOSURE_URL=https://example.com/ai-disclosure
# STUDIO_CREATOR_CHANNEL_TITLE="Your channel"
# STUDIO_DISPLAY_NAME="Your studio"
# STUDIO_AI_DISCLOSURE_TEXTS='{"en": "Disclosure: this video was produced with generative AI by {studio}."}'
# Legacy: one OAuth triple in .env instead of a connected account. Prefer the page.
STUDIO_YOUTUBE_CLIENT_ID=
STUDIO_YOUTUBE_CLIENT_SECRET=
STUDIO_YOUTUBE_REFRESH_TOKEN=
# Optional: the channel these credentials publish to (informational).
STUDIO_YOUTUBE_CHANNEL_ID=

# ========================================================================== MONEY AND LIMITS ===
# Vendors are connected in the page: Setări → Furnizori AI (language models) and Setări → Video și
# sunet (Runway, ElevenLabs). Their keys live in the encrypted vault beside the database, never here.
# What the studio optimises for when it picks a model itself: premium | balanced | thrifty.
# STUDIO_PRODUCTION_PRIORITY=premium
# The most one film may spend on motion, and on all its paid steps (stills, hero, motion, paid
# redos), in USD. Empty film budget = the motion budget plus a six-scene stills cap (15.24 USD
# with the defaults), which a four-scene 10 s film at 1080p already exceeds: set your own.
# STUDIO_MOTION_BUDGET_USD=12.0
# STUDIO_FILM_BUDGET_USD=40
# The motion step films at 1080p or the cheaper 720p.
# STUDIO_MOTION_RESOLUTION=1080p
# The vendor account must hold this multiple of a paid step's next round before the step
# starts, and of each later purchase before it is bought; the approved cap stays the ceiling.
# STUDIO_PAID_STEP_BALANCE_MARGIN=1.15
# Paid attempts a scene may have before it waits for the Owner.
# STUDIO_MAX_PAID_ATTEMPTS_PER_SCENE=3
# Paid scene redos after a failed quality control, per scene and per film (0 = none).
# STUDIO_FILM_MAX_PAID_REDOS_PER_SCENE=1
# STUDIO_FILM_MAX_PAID_REDOS=2
# How long one film's purchase lease stands (seconds), and how many days a stalled film waits
# before the Director retires it.
# STUDIO_FILM_PURCHASE_LEASE_SECONDS=10800
# STUDIO_FILM_WAIT_DAYS=3
# Above this estimated USD a paid generation is a higher-tier question (SUPERVISED asks it).
# STUDIO_PAID_GENERATION_APPROVAL_THRESHOLD_USD=5.0
# How long a question stands (hours); a paid step of a film stands longer.
# STUDIO_APPROVAL_EXPIRES_AFTER_HOURS=24
# STUDIO_PAID_MEDIA_APPROVAL_EXPIRES_HOURS=48
# The daily token ceiling for all employees together; 0 = none (the preflight warns when a paid
# model runs with none).
# STUDIO_AGENT_DAILY_TOKEN_BUDGET=0
# Director output/thinking allowance multiplier per call (1..4); 2 doubles every explicit
# Director limit, including QC 6000 -> 12000. Independent daily token/USD gates still apply.
# STUDIO_DIRECTOR_TOKEN_MULTIPLIER=2
# A price move of this many percent is a letter; a quote off by more than the tolerance is stale.
# STUDIO_PRICE_CHANGE_ALERT_PERCENT=10.0
# STUDIO_PRICE_STALE_TOLERANCE_PERCENT=5.0
# In TEST: how many scenes get motion, what one generation and one second may cost, and how
# many motion scenes a render may have at most (empty = every scene).
# STUDIO_TEST_MOTION_SCENES=2
# STUDIO_TEST_MAX_COST_PER_GENERATION_USD=0.60
# STUDIO_TEST_MAX_COST_PER_SECOND_USD=0.12
# STUDIO_MOTION_SCENES_MAX=
# How many scenes of a TEST film may be stills before QC warns (empty = half the scenes).
# STUDIO_MAX_FALLBACK_SCENES=

# ===================================================================== MODELS COME AND GO ===
# STUDIO_AUTO_DISCOVER_MODELS=true
# Benchmarking spends money: off unless you turn it on, and bounded by the budget below (USD).
# STUDIO_AUTO_BENCHMARK_NEW_MODELS=false
# STUDIO_MAX_BENCHMARK_BUDGET_USD=1.50
# STUDIO_AUTO_PROMOTE_CHEAPER_BETTER_MODELS=true
# STUDIO_AUTO_DEMOTE_EXPENSIVE_MODELS=true
# STUDIO_MIN_TEST_SAMPLES_FOR_PROMOTION=3
# Model names you refuse, comma-separated shell patterns (* matches).
# STUDIO_MODEL_DENY_LIST=
# The vendors' model catalogues are read again on this cadence (seconds).
# STUDIO_PROVIDER_CATALOG_REFRESH_ENABLED=true
# STUDIO_PROVIDER_CATALOG_REFRESH_SECONDS=21600
# STUDIO_PROVIDER_CATALOG_RETRY_SECONDS=900
# STUDIO_PROVIDER_CATALOG_POLL_SECONDS=60
# The RunPod GPU guard: at start, every minute while a GPU session is open (10 minutes
# otherwise) and at shutdown it switches off a RunPod GPU left on. It only ever stops spending.
# STUDIO_RUNPOD_GUARD_ENABLED=true

# ===================================================================== THE OFFICE (optional) ===
# Live weather over the office scene: an Open-Meteo compatible forecast host; unset = none drawn.
# STUDIO_OFFICE_WEATHER_HOST=api.open-meteo.com
# STUDIO_OFFICE_WEATHER_REFRESH_SECONDS=600
# The headquarters rendered live in Unreal Engine (Pixel Streaming) — optional, needs your own
# Unreal install and level. The player port of Epic's signalling server
# (art-source/unreal/live/wilbur.config.json); unset = the page shows its own renderer.
# STUDIO_OFFICE_STREAM_SIGNALLING_URL=ws://127.0.0.1:8890
# Where the newest real frame of the stream is kept (empty = `office` beside the database).
# STUDIO_OFFICE_KEPT_FRAME_DIR=
# Unreal's Remote Control API, which seats and animates the employees in the live level.
# STUDIO_OFFICE_UNREAL_REMOTE_URL=http://127.0.0.1:30010
# STUDIO_OFFICE_UNREAL_SEAT_REPORT=art-source/unreal/people/seat_report.json
# STUDIO_OFFICE_UNREAL_SYNC_SECONDS=5.0
# STUDIO_OFFICE_UNREAL_ENV_REPORT=art-source/unreal/env_report.json
# STUDIO_OFFICE_UNREAL_ENV_REFRESH_SECONDS=20.0
# STUDIO_OFFICE_UNREAL_ENV_EASE_SECONDS=30.0
# The compass heading the building's facade faces (degrees).
# STUDIO_OFFICE_FACADE_HEADING_DEG=180.0
# A rehearsal hour for the scene, for a COPY of the database only (refused on data/studio.db).
# STUDIO_OFFICE_WORLD_REHEARSAL_AT=2026-06-21T20:30:00+00:00

# ======================================================================== DEMO AND THE SUITE ===
# The demo is started with `uv run python scripts/start.py --demo`, which sets this itself on an
# isolated database: every vendor simulated, nothing bought, nothing published. Never set it on
# your real studio's database.
# STUDIO_DEMO_MODE=false
# For the test suite only: fail instead of skip when FFmpeg is missing; use the production encode.
# STUDIO_REQUIRE_FFMPEG=1
# STUDIO_REAL_ENCODE=1
# A COPY of a studio database for the opt-in rehearsal test (never the live data/studio.db).
# STUDIO_REHEARSAL_DB=

# Worker checks film-sheet blockers at this interval, without an open browser (seconds).
STUDIO_SHEET_BLOCKER_SCAN_SECONDS=300

# RUNPOD GPU CLOUD — optional. Empty values use safe defaults; no cloud activity.
# Prefer the connection form (Settings → Video și sunet → RunPod): its keys go to the vault.
# Serverless is the default: the GPU (at most 1, RTX PRO 6000, budgeted at 4.00 USD/h) is
# switched on only inside an approved paid step and off right after its last result
# (workers.max=0, idleTimeout 1 s). Outputs go to YOUR S3-compatible bucket (e.g. Cloudflare R2).
RUNPOD_ENABLED=
RUNPOD_MOCK=
# serverless (default) or pod (frozen).
RUNPOD_MODE=
RUNPOD_API_KEY=
# Legacy single endpoint; prefer one endpoint for stills and one for motion.
RUNPOD_ENDPOINT_ID=
RUNPOD_STILLS_ENDPOINT_ID=
RUNPOD_MOTION_ENDPOINT_ID=
RUNPOD_GENERATION_BASE_URL=
RUNPOD_GPU_NAME=
RUNPOD_GPU_VRAM_GB=
# The Pod rate (2.09); the Serverless budget rate is RUNPOD_SERVERLESS_COST_PER_HOUR (4.00).
RUNPOD_GPU_COST_PER_HOUR=
RUNPOD_SERVERLESS_COST_PER_HOUR=
# The Serverless GPU: idle tail (1 s, the documented minimum), one GPU at most, model load priced
# once per round, endpoint execution timeout (ms) and FlashBoot (OFF|FLASHBOOT|PRIORITY_FLASHBOOT).
RUNPOD_IDLE_TIMEOUT_SECONDS=
RUNPOD_MAX_WORKERS=
RUNPOD_COLD_START_SECONDS=
RUNPOD_ENDPOINT_TIMEOUT_MS=
RUNPOD_FLASHBOOT=
RUNPOD_EXECUTION_TIMEOUT_CAP_SECONDS=
RUNPOD_STILL_ITEM_BUDGET_SECONDS=
RUNPOD_CLIP_ITEM_BUDGET_SECONDS=
RUNPOD_QUEUE_WAIT_SECONDS=
# How long the off is watched for 0 running, and the guard's cadence.
RUNPOD_OFF_GRACE_SECONDS=
RUNPOD_OFF_POLL_SECONDS=
RUNPOD_SESSION_STALE_SECONDS=
RUNPOD_SESSION_MAX_SECONDS=
RUNPOD_GPU_BUSY_WAIT_SECONDS=
RUNPOD_GUARD_INTERVAL_SECONDS=
RUNPOD_GUARD_IDLE_INTERVAL_SECONDS=
# The output bucket (any S3-compatible endpoint, HTTPS, no key in the URL); presigned URLs live
# at most 7 days (604800 s). The two keys belong in the vault, set through the connection form.
RUNPOD_S3_ENDPOINT_URL=
RUNPOD_S3_BUCKET=
RUNPOD_S3_REGION=
RUNPOD_S3_PREFIX=
RUNPOD_S3_ACCESS_KEY_ID=
RUNPOD_S3_SECRET_ACCESS_KEY=
RUNPOD_URL_TTL_SECONDS=
RUNPOD_REQUEST_TIMEOUT=
RUNPOD_POLL_INTERVAL=
RUNPOD_MAX_RETRIES=
RUNPOD_JOB_TIMEOUT=
RUNPOD_ALLOW_INFRA_ACTIONS=
RUNPOD_AUTO_START=
RUNPOD_AUTO_STOP=
RUNPOD_IDLE_SHUTDOWN_MINUTES=
RUNPOD_POD_ID=
RUNPOD_POD_CANCEL_PATH=
RUNPOD_MODEL_ROUTES=
