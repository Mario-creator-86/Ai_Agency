+# ---------------------------------------------------------------- the towers' windows
+def test_the_towers_light_no_window_by_day_a_few_below_five_degrees_all_at_dusk():
+    from app.office.scene_params import WINDOWS_FEW, windows_on, windows_share
+
+    assert windows_share(45.0) == 0.0 and windows_share(5.0) == 0.0
+    assert 0.0 < windows_share(2.7) < WINDOWS_FEW  # the 18:50 instant: a few windows
+    assert windows_share(0.0) == pytest.approx(WINDOWS_FEW)
+    assert windows_share(-2.5) == 1.0 and windows_share(-30.0) == 1.0
+    elevations = [x / 10 for x in range(80, -60, -1)]
+    shares = [windows_share(e) for e in elevations]
+    assert shares == sorted(shares)
+    assert windows_on(1.0) == 1.0 and windows_on(0.0) == 0.0
+    assert 0.02 < windows_on(0.5) < 0.95
+    # the morning and the evening at the same elevation light the same windows (no invented
+    # occupancy; a morning share would be the Owner's decision)
+    morning = scene_params(world(elevation=2.0, azimuth=100.0), FRAME)["towers"]
+    evening = scene_params(world(elevation=2.0, azimuth=260.0), FRAME)["towers"]
