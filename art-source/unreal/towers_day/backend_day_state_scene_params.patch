     return math.sqrt(min(1.0, sky_brightness(elevation)))
 
 
+def windows_share(elevation: float) -> float:
+    """The share of the dusk's lit windows lit at this real solar elevation (WINDOWS_* above)."""
+    if elevation >= WINDOWS_OFF_ABOVE:
+        return 0.0
+    if elevation >= WINDOWS_FEW_AT:
+        return WINDOWS_FEW * smoothstep(WINDOWS_OFF_ABOVE, WINDOWS_FEW_AT, elevation)
+    if elevation > REFERENCE_DUSK_ELEVATION:
+        return mix(WINDOWS_FEW, 1.0, smoothstep(WINDOWS_FEW_AT, REFERENCE_DUSK_ELEVATION, elevation))
+    return 1.0
+
+
+def windows_on(share: float) -> float:
+    """M_HQ_TowerDay's WindowsOn for that share: 1 (every window, exactly the dusk) at 1, 0 at 0."""
+    if share >= 1.0:
+        return 1.0
+    if share <= 0.0:
+        return 0.0
+    return TOWER_RANK_MIN + (TOWER_RANK_MAX - TOWER_RANK_MIN) * share
+
+
