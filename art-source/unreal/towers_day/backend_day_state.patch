     assert at(40.0, 100.0) == pytest.approx(100.0)
+
+
+# ---------------------------------------------------------------- the day state
+DAY_STATE = {
+    "towers": [
+        entry("skyline", "StaticMeshActor_10", "StaticMeshComponent0"),
+        entry("near_blocks", "StaticMeshActor_11", "StaticMeshComponent0"),
+    ],
+    "trees": [entry("tree_0", "StaticMeshActor_30", "StaticMeshComponent0")],
+    "skyline_daylight": f"{LEVEL}.StaticMeshActor_10.StaticMeshComponent0",
+}
+
+
+def test_without_a_day_state_no_day_parameter_is_sent(tmp_path):
+    sender = Recorder()
+    EnvironmentPass(sender, clock=Clock()).sync(world(40.0, 180.0), report(tmp_path), 180.0)
+    names = {b["parameters"].get("ParameterName") for b in sender.calls}
+    assert not names & {"TowerDaylight", "WindowsOn", "LeafDaylight"}
+
+
+def test_the_day_state_reaches_the_towers_the_trees_and_the_bridge(tmp_path):
+    rep_dict = json.loads(json.dumps(REPORT))
+    rep_dict["day_state"] = DAY_STATE
+    rep = load_env_report(write_report(tmp_path, rep_dict))
+
+    def sent(elevation, azimuth):
+        sender = Recorder()
+        EnvironmentPass(sender, clock=Clock()).sync(world(elevation, azimuth), rep, 180.0)
+        out = {}
+        for b in sender.calls:
+            name = b["parameters"].get("ParameterName")
+            if name in ("TowerDaylight", "WindowsOn", "LeafDaylight", "Daylight"):
+                assert b["functionName"] == "SetScalarParameterValueOnMaterials"
+                actor = b["objectPath"].rsplit(".", 2)[-2]
+                out[(actor, name)] = b["parameters"]["ParameterValue"]
+        return out
+
+    dusk = sent(-2.5, 274.3)
+    for actor in ("StaticMeshActor_10", "StaticMeshActor_11"):
+        assert dusk[(actor, "TowerDaylight")] == 0.0
+        assert dusk[(actor, "WindowsOn")] == 1.0
+    assert dusk[("StaticMeshActor_30", "LeafDaylight")] == 0.0
+    # Daylight: the near blocks as before, and now the skyline's plain slots too
+    assert dusk[("StaticMeshActor_10", "Daylight")] == 0.0
+    assert dusk[("StaticMeshActor_11", "Daylight")] == 0.0
+    noon = sent(46.97, 180.0)
+    assert noon[("StaticMeshActor_10", "WindowsOn")] == 0.0
+    assert noon[("StaticMeshActor_10", "TowerDaylight")] == 1.0
+    assert noon[("StaticMeshActor_30", "LeafDaylight")] == 1.0
+    assert noon[("StaticMeshActor_10", "Daylight")] == 1.0
