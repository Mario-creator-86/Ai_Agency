+  const cover = journalCoverHtml(
+    { id: 'c', status: 'REJECTED', reviewed_by: 'checks', title: 'The Ninth Rewrite', beats: [], grounded_event_ids: [], review: computed, continuity: { episode_number: 2, business_date: '2026-10-13' } },
