+def _she_says(verdict: str, *notes: str):
+    def answer(prompt: str) -> str:
+        return json.dumps(
+            {
+                "verdict": verdict,
+                "hook_strength": 7,
+                "clarity": 7,
+                "payoff": 7,
+                "cta_fit": 6,
+                "retention": {
+                    "at_0": 100,
+                    "at_3": 70,
+                    "at_10": 55,
+                    "at_end": 45,
+                    "collapse_at": "3-9",
+                    "why": "the setup repeats the hook",
+                },
+                "notes": list(notes) or ["Strânge scena 3."],
+            }
+        )
+
+    return answer
