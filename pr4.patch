+    assert INSIST["reason"] in reply.body_text and "insist" in reply.body_text
+    assert recorded["letter_id"] == letter.id
+    opinions = _opinions(engine)
+    assert [row.agent_id for row in opinions] == [
+        studio["agents"]["Accountant"],
